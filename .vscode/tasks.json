{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run go file",
            "type": "shell",
            "command": "go run ${file}"
        },
        {
            "label": "Docker Compose Up",
            "type": "shell",
            "command": "docker compose -f ${workspaceFolder}/src/PC3/docker-compose.yml up --build --detach",
            "problemMatcher": []
        },
        {
            "label": "Docker Compose Down",
            "type": "shell",
            "command": "docker compose down",
            "problemMatcher": []
        },
        {
            "label": "Run PC3 (Go)",
            "type": "shell",
            "command": "go run .",
            "options": {
                "cwd": "${workspaceFolder}/src/PC3",
                "env": {
                    "MONGODB_URI": "mongodb://user:pass@localhost:27017/?authSource=admin"
                }
            },
            "problemMatcher": []
        }
    ]
}