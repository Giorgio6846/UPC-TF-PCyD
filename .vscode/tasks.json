{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run go file",
            "type": "shell",
            "command": "go run ${file}"
        },
        {
            "label": "Docker Compose Up (Single)",
            "type": "shell",
            "command": "docker compose -f ${workspaceFolder}/docker-compose.yml up --build --detach",
            "problemMatcher": []
        },
        {
            "label": "Docker Compose Up (Distributed)",
            "type": "shell",
            "command": "docker compose -f ${workspaceFolder}/docker-compose.yml up --scale worker=10 --build --detach",
            "problemMatcher": []
        },
        {
            "label": "Docker Compose Down",
            "type": "shell",
            "command": "docker compose down",
            "problemMatcher": []
        },

    ]
}